SERVER_IP=192.168.0.28
SERVER_PORT=8000

# Gates every write endpoint (/api/items, /api/screenshot, the /api/workspaces
# mutations) and the agent's own /ws/agent handshake.
AGENT_TOKEN=change-me

# Gates the Dashboard's /ws/client socket. Deliberately a *different* secret
# from AGENT_TOKEN: this one is typed into a phone browser over plain http, so
# leaking it must not also hand over the item catalog and agent impersonation.
#
# The backend fails closed -- leave this unset and every Dashboard connection is
# refused with close code 4001. Set it before deploying, then hand it to the
# phone once by opening http://<server>:8000/?token=<value> (the value is
# stored in localStorage and stripped from the URL) or by typing it into the
# prompt the Dashboard shows when it has none.
CLIENT_TOKEN=change-me-too
